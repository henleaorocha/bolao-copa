# Supabase — obter em https://supabase.com/dashboard/project/<ID>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_ID>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>

# Apenas no servidor (nunca expor ao browser)
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# Segredo de assinatura dos JWTs do projeto (Settings → API → JWT Settings →
# JWT Secret). Usado SÓ pelo connector MCP: com ele o servidor assina um token de
# curta duração em nome do participante, e as consultas do connector passam a
# obedecer exatamente as mesmas policies de RLS do app — sem reimplementar
# permissão em código. Sem esta variável, /api/mcp responde 500.
SUPABASE_JWT_SECRET=<SUPABASE_JWT_SECRET>

# URL pública do app (usado para CSRF e redirects)
# Local: http://localhost:3000 | Produção: https://bolao-copa.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
